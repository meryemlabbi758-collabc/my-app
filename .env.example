# SharePoint/Datalake Configuration

# Enable real data from SharePoint datalake (set to 'true' to use real data, 'false' for mock)
REACT_APP_SHAREPOINT_ENABLED=true

# Backend API URL (where your backend queries the parquet files)
REACT_APP_BACKEND_API_URL=http://localhost:3001/api

# SharePoint site URL (if using direct access)
REACT_APP_SHAREPOINT_SITE=https://your-sharepoint-site

# SharePoint data folder (if using direct access)
REACT_APP_SHAREPOINT_DATA_FOLDER=gold

# Authentication token (if needed)
REACT_APP_AUTH_TOKEN=

# Environment
REACT_APP_ENV=development
